  {
   "name": "Register Client",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{accessToken}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "X-Client-Secret",
      "value": "{{clientSecret}}"
     }
    ],
    "url": {
     "raw": "{{baseUrl}}/api/v1/client/register-client",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "v1",
      "client",
      "register-client"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"username\": \"string\",\n  \"password\": \"string\",\n  \"name\": \"string\"\n}"
    }
   }
