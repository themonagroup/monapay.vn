---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import { PLANS, PAID_PLANS, CHEAPEST_PAID, FREE_TX_PER_MONTH, YEARLY_MONTHS, TX_RULE, FREE_OVER_QUOTA_POLICY, PAID_OVER_QUOTA_POLICY, FAIR_USE, fmt, fmtVnd } from '../data/pricing';
import MonaFreeBanner from '../components/MonaFreeBanner.astro';

// Trang giá: 1 gói Miễn phí + 4 gói trả phí theo số giao dịch (nguồn: pricing/plans.json). Mon chốt 31/08/2026.
const title = `Bảng giá cổng thanh toán MONA Pay: miễn phí ${fmt(FREE_TX_PER_MONTH)} giao dịch/tháng`;
const description = `Bảng giá MONA Pay: gói Miễn phí ${fmt(FREE_TX_PER_MONTH)} giao dịch/tháng đủ tính năng, 4 gói trả phí từ ${fmtVnd(CHEAPEST_PAID.price_month)}/tháng tính theo số giao dịch, không thu phần trăm trên số tiền.`;

const idx = (code: string) => PLANS.findIndex((p) => p.code === code);
const fromPlan = (code: string) => (p: (typeof PLANS)[number]) => (idx(p.code) >= idx(code) ? '✓' : '–');
const matrix: { label: string; cell: (p: (typeof PLANS)[number]) => string }[] = [
  { label: 'Giao dịch tiền vào mỗi tháng', cell: (p) => fmt(p.tx_limit) },
  { label: 'Giá theo tháng', cell: (p) => (p.price_month === 0 ? '0 đ' : fmtVnd(p.price_month)) },
  { label: `Giá theo năm (trả ${YEARLY_MONTHS} tháng)`, cell: (p) => (p.price_month === 0 ? '0 đ' : fmtVnd(p.price_year)) },
  { label: 'Vượt hạn mức', cell: (p) => (p.overage_per_tx ? `Không khoá, +${p.overage_per_tx} đ mỗi giao dịch vượt` : 'Tháng đầu du di, sau đó ngưng báo phần vượt tới khi nâng gói') },
  { label: 'Tài khoản ảo, VietQR động, webhook ký HMAC, Telegram, API', cell: () => '✓' },
  { label: 'Số webhook, số nhóm Telegram', cell: () => 'Không giới hạn' },
  { label: 'Dashboard sổ giao dịch, lịch sử gửi webhook', cell: () => '✓' },
  { label: 'Xuất CSV đối soát', cell: fromPlan('startup') },
  { label: 'Nhiều tài khoản ngân hàng, nhiều tài khoản ảo', cell: fromPlan('business') },
  { label: 'Hoá đơn VAT', cell: fromPlan('business') },
  { label: 'Kỹ sư MONA hỗ trợ tích hợp trực tiếp', cell: fromPlan('enterprise') },
  { label: 'Người trực riêng cho hệ thống lớn', cell: fromPlan('scale') },
  { label: 'Hỗ trợ', cell: (p) => (idx(p.code) >= idx('startup') ? `Ưu tiên, tổng đài ${SITE.hotline}` : `Tổng đài ${SITE.hotline}`) },
];

// Ví dụ chọn gói theo lượng đơn thật (số giao dịch = số khoản tiền vào)
const viDu = [
  { ai: 'Shop bán qua Facebook, Zalo, 15 đơn mỗi ngày', gd: '≈ 450 giao dịch/tháng', goi: 'Miễn phí', tien: '0 đ' },
  { ai: 'Trung tâm 300 học viên đóng học phí hằng tháng', gd: '≈ 300 giao dịch/tháng', goi: 'Miễn phí', tien: '0 đ' },
  { ai: 'Website bán hàng 50 đơn mỗi ngày', gd: '≈ 1.500 giao dịch/tháng', goi: 'Khởi nghiệp', tien: `${fmtVnd(PLANS[1].price_month)}/tháng` },
  { ai: 'Chuỗi 8 cửa hàng, 300 hoá đơn chuyển khoản mỗi ngày', gd: '≈ 9.000 giao dịch/tháng', goi: 'Kinh doanh', tien: `${fmtVnd(PLANS[2].price_month)}/tháng` },
  { ai: 'Sàn, phần mềm SaaS 1.500 khoản tiền vào mỗi ngày', gd: '≈ 45.000 giao dịch/tháng', goi: 'Doanh nghiệp', tien: `${fmtVnd(PLANS[3].price_month)}/tháng` },
];

// So sánh với cổng thanh toán quốc tế. Số PayPal lấy từ trang phí chính thức PayPal Việt Nam, Stripe từ trang quốc gia hỗ trợ của Stripe, kiểm 28/08/2026.
const soSanh = [
  { label: 'Phí mỗi giao dịch', mona: `0 đ tới ${fmt(FREE_TX_PER_MONTH)} giao dịch/tháng; trên đó gói cố định theo số giao dịch, từ ${fmtVnd(CHEAPEST_PAID.price_month)}/tháng`, paypal: '4,40% + phí cố định theo tiền tệ (giao dịch thương mại từ ngoài Việt Nam)', stripe: 'Chưa mở cho doanh nghiệp tại Việt Nam' },
  { label: 'Thu phần trăm trên số tiền', mona: 'Không, ở mọi gói', paypal: 'Có, 4,40%', stripe: 'Không áp dụng' },
  { label: 'Phí rút tiền về ngân hàng Việt Nam', mona: 'Không có, tiền vào thẳng tài khoản ngân hàng', paypal: '60.000đ mỗi lần khi không quy đổi tiền tệ; rút lỗi bị trả lại thêm 70.000đ', stripe: 'Không áp dụng' },
  { label: 'Đăng ký từ Việt Nam', mona: 'Được, đăng ký xong dùng ngay', paypal: 'Được', stripe: 'Chưa (trang quốc gia hỗ trợ ngày 28/08/2026 không có Việt Nam)' },
  { label: 'Chuyển khoản nội địa, VietQR', mona: 'Có, tài khoản ảo riêng từng đơn + VietQR động', paypal: 'Không', stripe: 'Không' },
  { label: 'Tiền về đâu', mona: 'Vào thẳng tài khoản ngân hàng, MONA Pay chỉ báo', paypal: 'Nằm trong ví PayPal, anh chị tự rút về ngân hàng', stripe: 'Không áp dụng' },
  { label: 'Hợp với việc gì', mona: 'Thu tiền khách trong nước qua chuyển khoản', paypal: 'Bán cho khách nước ngoài trả bằng thẻ, USD', stripe: 'Doanh nghiệp đăng ký tại nước Stripe hỗ trợ' },
];

const faq = [
  { q: `Vượt ${fmt(FREE_TX_PER_MONTH)} giao dịch một tháng thì sao?`,
    a: `${FREE_OVER_QUOTA_POLICY} Anh chị nâng gói ngay trong dashboard my.monapay.vn, mục Gói và thanh toán: chọn gói, chuyển khoản theo mã QR, hệ thống tự kích hoạt trong vài giây. ${PAID_OVER_QUOTA_POLICY}` },
  { q: 'Giao dịch được đếm thế nào?',
    a: `${TX_RULE} Một đơn 50.000 đ hay 50.000.000 đ đều tính là 1 giao dịch, nên gói không đắt lên khi anh chị bán món giá cao.` },
  { q: 'MONA Pay có thu phần trăm trên số tiền giao dịch không?',
    a: 'Không, ở mọi gói. Tiền không đi qua MONA Pay nên không có phí giữ tiền, phí rút hay phần trăm trên giá trị đơn hàng. Anh chị chỉ trả một khoản cố định theo bậc giao dịch mỗi tháng, gói nào cũng niêm yết công khai tại trang này.' },
  { q: 'Gói Miễn phí có bị cắt tính năng không?',
    a: `Không. Gói Miễn phí có đủ tài khoản ảo, mã VietQR động, webhook ký HMAC kèm lịch sử gửi, thông báo Telegram, API v1 và tài liệu máy đọc; khác gói trả phí ở hạn mức ${fmt(FREE_TX_PER_MONTH)} giao dịch mỗi tháng, xuất CSV, nhiều tài khoản ngân hàng, mức hỗ trợ và hoá đơn VAT. Tụi em muốn anh chị chạy thật với tiền thật rồi mới quyết định trả tiền.` },
  { q: 'Thanh toán gói bằng cách nào?',
    a: `Bằng chính MONA Pay. Trong dashboard anh chị chọn gói và kỳ hạn tháng hay năm, hệ thống tạo hoá đơn kèm mã VietQR chuyển khoản vào tài khoản ACB của ${SITE.company}. Chuyển xong, tiền vào là hệ thống tự khớp mã hoá đơn và mở gói trong vài giây, không cần gửi ảnh bill, không chờ ai duyệt. Hoá đơn chưa thanh toán tự hết hạn sau 48 giờ.` },
  { q: 'Hết hạn gói, đổi gói, huỷ gói thì sao?',
    a: `Không ràng buộc. Gói trả phí hết hạn mà chưa gia hạn thì sau 7 ngày tài khoản về gói Miễn phí, dữ liệu giao dịch, webhook, Telegram giữ nguyên. Đổi lên gói cao hơn thì gói mới tính từ lúc thanh toán. Giá gói có thay đổi tụi em báo trước ít nhất 30 ngày trên dashboard và trang này; gói đang trả tiền giữ giá tới hết kỳ đã thanh toán.` },
  { q: 'Có xuất hoá đơn VAT không?',
    a: `Từ gói Kinh doanh trở lên có hoá đơn VAT, pháp nhân xuất là ${SITE.company}, đơn vị đứng sau MONA Pay từ ${SITE.founded}. Gói Khởi nghiệp cần hoá đơn thì gọi ${SITE.hotline} để tụi em xử lý riêng.` },
];

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'Product', name: 'MONA Pay', description: SITE.entity, url: SITE.url + '/bang-gia',
  brand: { '@type': 'Brand', name: 'MONA Pay' },
  offers: PLANS.map((p) => ({ '@type': 'Offer', name: `Gói ${p.name}: ${fmt(p.tx_limit)} giao dịch/tháng`, price: String(p.price_month), priceCurrency: 'VND', availability: 'https://schema.org/InStock', url: SITE.url + '/bang-gia#goi-' + p.code })),
}];
---
<Base title={title} description={description} path="/bang-gia" jsonld={jsonld}>

  <section class="hero">
    <div class="wrap narrow">
      <span class="eyebrow">Bảng giá</span>
      <h1>Bảng giá cổng thanh toán MONA Pay:<br class="br-d" /> <span class="accent">miễn phí {fmt(FREE_TX_PER_MONTH)} giao dịch mỗi tháng</span></h1>
      <div class="answer-first">
        <p>MONA Pay có gói Miễn phí {fmt(FREE_TX_PER_MONTH)} giao dịch mỗi tháng với đầy đủ tính năng: tài khoản ảo, VietQR, webhook, Telegram, API. Dùng nhiều hơn thì có 4 gói trả phí từ {fmtVnd(CHEAPEST_PAID.price_month)} mỗi tháng, tính theo số giao dịch chứ không theo số tiền, trả năm chỉ tính {YEARLY_MONTHS} tháng. Tiền không đi qua MONA Pay, nên không có phí giữ tiền hay phí rút.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <MonaFreeBanner />
      <div class="plans">
        {PLANS.map((p) => (
          <div class={'price-card' + (p.featured ? ' featured' : '')} id={'goi-' + p.code}>
            {p.featured && <span class="badge badge-cta" style="margin-bottom:.8rem">Nhiều người chọn</span>}
            <h3>{p.name}</h3>
            <p class="price">{p.price_month === 0 ? '0 đ' : fmtVnd(p.price_month)} <small>/ tháng</small></p>
            {p.price_month > 0 ? <p class="year">hoặc {fmtVnd(p.price_year)}/năm, tiết kiệm {12 - YEARLY_MONTHS} tháng</p> : <p class="year">không cần thẻ, không hết hạn</p>}
            <p class="tx"><strong>{fmt(p.tx_limit)} giao dịch</strong> tiền vào mỗi tháng</p>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            {p.price_month === 0
              ? <a class="btn btn-primary" href={SITE.appRegister}>Tạo tài khoản miễn phí</a>
              : <a class="btn btn-outline" href={SITE.appRegister}>Đăng ký rồi nâng gói</a>}
          </div>
        ))}
      </div>
      <p class="note">Nâng gói ngay trong dashboard: chọn gói, chuyển khoản theo mã QR, hệ thống tự mở gói trong vài giây. Không ký hợp đồng, không ràng buộc thời hạn.</p>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">Cách tính</span>
      <h2>Giao dịch tính thế nào,<br class="br-d" /> vượt mức thì sao</h2>
      <div class="grid grid-3">
        <div class="card"><div class="icon">1</div><h3>Một giao dịch là gì</h3><p>{TX_RULE} Một đơn 50.000 đ hay 50.000.000 đ đều tính là 1, nên gói không đắt lên khi anh chị bán món giá cao.</p></div>
        <div class="card"><div class="icon">2</div><h3>Gói Miễn phí vượt mức</h3><p>{FREE_OVER_QUOTA_POLICY} Nâng gói lúc nào tiền vào là báo lại đầy đủ.</p></div>
        <div class="card"><div class="icon">3</div><h3>Gói trả phí vượt mức</h3><p>{PAID_OVER_QUOTA_POLICY} Vượt đều mỗi tháng thì lên gói kế tiếp rẻ hơn phụ trội, dashboard nhắc khi chạm 80% hạn mức.</p></div>
      </div>
      <h3 class="vd-h3">Chọn gói theo lượng đơn thật</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Anh chị bán thế nào</th><th>Số giao dịch</th><th>Gói hợp</th><th>Trả mỗi tháng</th></tr></thead>
          <tbody>{viDu.map((r) => <tr><td>{r.ai}</td><td>{r.gd}</td><td>{r.goi}</td><td><b>{r.tien}</b></td></tr>)}</tbody>
        </table>
      </div>
      <p class="note-left">Fair-use ngoài hạn mức: {FAIR_USE.note} {FAIR_USE.rateLimit}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Chi tiết gói</span>
      <h2>Gói nào có gì?</h2>
      <p class="lead">{SITE.entity}</p>
      <p class="lead">5 gói dùng chung một hệ thống, cùng độ an toàn, cùng tài liệu. Khác nhau ở hạn mức giao dịch mỗi tháng, xuất CSV, số tài khoản ngân hàng, hoá đơn VAT và mức hỗ trợ từ đội MONA.</p>
      <div class="table-wrap">
        <table class="matrix">
          <thead><tr><th>Tính năng</th>{PLANS.map((p) => <th>{p.name}</th>)}</tr></thead>
          <tbody>
            {matrix.map((r) => (
              <tr>
                <td>{r.label}</td>
                {PLANS.map((p) => { const v = r.cell(p); return <td class={v === '✓' ? 'check' : ''}>{v}</td>; })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">Vì sao gói miễn phí rộng vậy</span>
      <h2>{fmt(FREE_TX_PER_MONTH)} giao dịch miễn phí mỗi tháng,<br class="br-d" /> MONA lấy gì để nuôi?</h2>
      <div class="grid grid-3" style="margin-top:1.5rem">
        <div class="card">
          <div class="icon">1</div>
          <h3>Hệ thống đã chạy thật cho hơn 6.000 khách hàng</h3>
          <p>{SITE.company} tự viết hệ thống này để thu tiền hosting, học phí, đơn phần mềm cho chính mình, rồi từ 2022 tới nay hơn 6.000 khách hàng mới của MONA đã thu tiền qua đây trong web, phần mềm tụi em giao. Hạ tầng, đội kỹ thuật, quy trình đối soát đều có sẵn; thêm một shop nhỏ dùng chung gần như không tốn thêm gì, nên tụi em để mức miễn phí rộng.</p>
        </div>
        <div class="card">
          <div class="icon">2</div>
          <h3>Tiền không qua MONA Pay nên không có phí trung gian</h3>
          <p>Khách chuyển khoản là tiền nằm trong tài khoản ngân hàng của anh chị ngay lúc đó. MONA Pay chỉ đọc thông báo giao dịch từ ngân hàng rồi bắn webhook, nhắn Telegram. Không giữ tiền thì không có phí giữ tiền, không phí rút, không phần trăm trên đơn hàng, ở mọi gói.</p>
        </div>
        <div class="card">
          <div class="icon">3</div>
          <h3>Thu phí ở khách dùng nhiều, một khoản cố định nhỏ</h3>
          <p>Khách vượt {fmt(FREE_TX_PER_MONTH)} giao dịch mỗi tháng là khách đã bán đều, khoản {fmtVnd(CHEAPEST_PAID.price_month)} mỗi tháng nhỏ hơn tiền công một buổi ngồi đối chiếu sao kê. Phần này để tụi em nuôi đội trực và mở thêm ngân hàng. MONA vẫn sống chính bằng web ở <a href="https://mona.media">Mona.Media</a>, hosting ở <a href="https://mona.host">Mona.Host</a>, phần mềm ở <a href="https://mona.software">Mona.Software</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">So sánh</span>
      <h2>So với cổng thanh toán quốc tế thì giá và tính năng ra sao?</h2>
      <p class="lead">Anh chị hay hỏi PayPal, Stripe. Số dưới đây tụi em lấy từ trang phí chính thức của PayPal Việt Nam và trang quốc gia hỗ trợ của Stripe, kiểm ngày 28/08/2026. Hai cổng đó sinh ra để nhận tiền từ nước ngoài, MONA Pay sinh ra để xác nhận chuyển khoản trong nước. Khác bài toán, nên nhiều khách MONA dùng cả hai.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Hạng mục</th><th>MONA Pay</th><th>PayPal Việt Nam</th><th>Stripe</th></tr></thead>
          <tbody>{soSanh.map((r) => <tr><td>{r.label}</td><td>{r.mona}</td><td>{r.paypal}</td><td>{r.stripe}</td></tr>)}</tbody>
        </table>
      </div>
      <p>Đang cân nhắc cổng quốc tế cho web bán hàng? Đọc <a href="/cong-thanh-toan-quoc-te">so với cổng thanh toán quốc tế</a>, có bảng phí từng cổng và cách dùng song song với MONA Pay.</p>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap narrow">
      <Faq id="faq-gia" eyebrow="Hỏi đáp về giá" title="Câu hỏi về phí anh chị hay hỏi" items={faq} />
    </div>
  </section>

  <CtaBand title={`Bắt đầu với ${fmt(FREE_TX_PER_MONTH)} giao dịch miễn phí mỗi tháng`} body="Tạo tài khoản, nối ngân hàng bằng 2 lần OTP, cấu hình webhook hoặc Telegram. Cần nhiều hơn thì nâng gói ngay trong dashboard, tiền vẫn nằm trong tài khoản ngân hàng của anh chị." />
</Base>

<style>
  .br-d{display:inline}
  .hero h1{font-size:clamp(1.8rem,3.2vw,2.4rem)}
  @media (max-width:767px){.br-d{display:none}}
  .plans{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.9rem;align-items:start}
  @media (max-width:1100px){.plans{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media (max-width:760px){.plans{grid-template-columns:minmax(0,1fr)}}
  .plans .price-card{padding:1.3rem 1.1rem;min-width:0}
  .plans .btn{white-space:normal;line-height:1.25;padding:.6rem .7rem;font-size:.92rem}
  .plans .price{overflow-wrap:anywhere}
  .plans .price small{display:block;font-size:.85rem;margin-top:.1rem}
  .plans .price-card h3{font-size:1.15rem}
  .plans .price{font-size:1.6rem}
  .year{margin:.1rem 0 .6rem;font-size:.85rem;color:var(--text-soft)}
  .tx{color:var(--ink);margin:0 0 .6rem;font-size:.95rem}
