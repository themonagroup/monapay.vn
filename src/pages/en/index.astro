---
import Base from '../../layouts/Base.astro';
import Steps from '../../components/Steps.astro';
import { SITE } from '../../data/site';
const ENTITY_EN = 'MONA Pay is the payment gateway and bank API of The MONA Group that lets Vietnamese businesses receive and confirm bank transfers in real time via virtual accounts (VA), VietQR, webhooks and Telegram — built so both developers and AI agents can integrate in minutes.';
const title = 'MONA Pay: Vietnamese bank transfer API and webhooks, free';
const description = 'Receive and confirm Vietnamese bank transfers in real time through virtual accounts, VietQR, signed webhooks and Telegram. Free for 500 transactions a month, paid plans priced by transaction count, self-serve sign-up, docs built for developers and AI agents.';
const steps = [
  { title: 'Sign up and log in', body: 'Create an account at my.monapay.vn (or POST /api/v1/client/register-client). It works immediately; nobody has to approve it.' },
  { title: 'Create an API key', body: 'POST /api/v1/client-keys/generate returns a client_secret shown once. Send it as X-Client-Secret on every write request.' },
  { title: 'Link an ACB account', body: 'Enter the account number and phone, confirm two OTPs from ACB (one to create the virtual account, one to register notifications). About 5 minutes in the dashboard.' },
  { title: 'Register a webhook URL', body: 'POST /api/v1/client-webhooks with HMAC_SHA256 and a secret. MONA Pay signs every delivery with X-Mona-Signature and X-Mona-Timestamp.' },
  { title: 'Verify and answer 200', body: 'Recompute HMAC-SHA256(secret, timestamp + "." + raw_body), reject drift over 300 s, answer within 10 s, deduplicate by transaction_code.' },
  { title: 'Send a test, then go live', body: 'POST /api/v1/client-webhooks/test fires a DUMMY123 payload. Then a real transfer into the virtual account shows up on the dashboard and at your endpoint within seconds.' },
];
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'MONA Pay', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', url: SITE.url + '/en',
  description: ENTITY_EN, offers: { '@type': 'Offer', price: 0, priceCurrency: 'VND' }, publisher: { '@id': SITE.url + '/#organization' }, inLanguage: 'en',
}];
---
<Base title={title} description={description} path="/en" jsonld={jsonld} lang="en" alternate={{ vi: '/', en: '/en' }}>
  <section class="hero"><div class="wrap">
    <span class="eyebrow">English</span>
    <h1>Vietnamese bank transfers,<br class="br-d" /> <span class="accent">confirmed in real time</span></h1>
    <div class="answer-first"><p>{ENTITY_EN} Money goes straight into the merchant's bank account; MONA Pay only reads the bank's transaction notification and forwards it as a signed webhook or a Telegram message. Free tier of 500 transactions a month, paid plans priced by transaction count, self-serve sign-up.</p></div>
    <div class="btn-row">
      <a class="btn btn-primary" href={SITE.appRegister}>Create a free account</a>
      <a class="btn btn-outline" href="/en/docs">Read the docs</a>
      <a class="btn btn-ghost" href="/en/ai-agent">For AI agents</a>
    </div>
    <p style="color:var(--text-soft);font-size:.92rem;margin-top:1rem">Vietnamese version: <a href="/">monapay.vn</a> · Machine-readable: <a href="/llms.txt">llms.txt</a> · <a href="/openapi.json">openapi.json</a></p>
  </div></section>

  <section class="section-alt"><div class="wrap">
    <span class="eyebrow">Integration</span>
    <h2>Six steps from sign-up<br class="br-d" /> to the first confirmed payment</h2>
    <Steps items={steps} />
  </div></section>

  <section><div class="wrap">
    <h2>What you get</h2>
    <div class="grid grid-3">
      <div class="card"><div class="icon">VA</div><h3>Virtual accounts</h3><p>One ACB account number per order or customer. Money lands in your real account; the VA tells you which order paid, no transfer-note parsing.</p></div>
      <div class="card"><div class="icon">QR</div><h3>Dynamic VietQR</h3><p>QR codes with the amount and reference pre-filled, readable by every Vietnamese banking app. Create them via API or in the dashboard.</p></div>
      <div class="card"><div class="icon">WH</div><h3>Signed webhooks</h3><p>HMAC-SHA256 with a 5-minute replay window, per-delivery logs with error labels, manual resend, success-rate and P95 statistics.</p></div>
      <div class="card"><div class="icon">TG</div><h3>Telegram</h3><p>Every incoming transfer posted to your company's Telegram group, no code required.</p></div>
      <div class="card"><div class="icon">AI</div><h3>Built for AI agents</h3><p>llms.txt, a raw .md version of every docs page and openapi.json on the main domain. Paste one prompt into Claude Code, Codex or Cursor and the agent integrates on its own.</p></div>
      <div class="card"><div class="icon">0đ</div><h3>Free, no limit</h3><p>No percentage on your money, no setup fee, no transaction cap. Fair-use limits only to stop abuse.</p></div>
    </div>
  </div></section>

  <section class="section-alt"><div class="wrap narrow">
    <h2>Banks and coverage</h2>
    <p>ACB is live today; MB, BIDV, VietinBank, OCB, MSB, KienlongBank and TPBank are in the partner-registration process. Webhooks, Telegram and the API are shared across banks and the payload carries <code>bank_name</code>, so adding a bank never changes your integration. Status table: <a href="/ngan-hang">supported banks</a> (Vietnamese).</p>
    <p>MONA Pay is a product of The MONA Group (founded {SITE.founded}, {SITE.projects} web and software projects, {SITE.retention} of customers return). Since 2022 more than 6,000 new MONA customers have collected payments through this system; in 2026 it opened to every business. Support: {SITE.hotline} · <a href={'mailto:' + SITE.email}>{SITE.email}</a>.</p>
  </div></section>
</Base>
<style>.br-d{display:inline}@media (max-width:767px){.br-d{display:none}}.hero h1{font-size:clamp(1.9rem,3.6vw,2.6rem)}</style>
