---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Steps from '../components/Steps.astro';
import { SITE } from '../data/site';
import { PRICE_LINE } from '../data/pricing';

const title = 'Thông báo chuyển khoản tự động cho KiotViet: loa báo có, Zalo';
const description = 'Thông báo chuyển khoản tự động cho KiotViet. Loa thông báo thanh toán QR và nhóm Zalo; 0% phí, miễn phí 500 giao dịch/tháng, thử trước khi nối ngân hàng.';

const stepsNoi = [
  { title: 'Nối ACB vào MONA Pay', body: 'Đăng ký tại my.monapay.vn, dùng ngay. Wizard 4 bước, 2 lần OTP do ACB gửi về số điện thoại chủ tài khoản.' },
  { title: 'Mỗi hoá đơn KiotViet một mã VietQR động', body: 'Lớp nối gọi API tạo QR của MONA Pay khi thu ngân chọn chuyển khoản: số tiền đúng hoá đơn, nội dung là mã hoá đơn. Khách quét ngay tại quầy hoặc qua ảnh gửi trên chat.' },
  { title: 'Webhook có chữ ký về lớp nối', body: 'MONA Pay gửi JSON ký HMAC-SHA256, từ chối gói lệch quá 5 phút. Lớp nối trả HTTP 200 trong 10 giây; lỗi thì dashboard có lịch sử và nút gửi lại.' },
  { title: 'Lớp nối ghi nhận thanh toán trên KiotViet', body: 'Đọc mã hoá đơn, so số tiền, gọi API của KiotViet để ghi nhận đã thanh toán. Đội MONA viết cho khách hoặc dev của anh chị tự viết. Kiểm với KiotViet xem gói đang dùng có mở API không.' },
];
const stepsTam = [
  { title: 'Thu ngân tạo VietQR động trong dashboard MONA Pay', body: 'Nhập số tiền và mã hoá đơn, hiện QR lên màn hình hoặc in ra để khách quét. Không đụng gì tới KiotViet.' },
  { title: 'Tiền vào, nhóm Zalo hoặc Telegram nhận báo có', body: 'Tin về trong vài giây với ngân hàng, số tài khoản, số tiền, thời gian và nội dung. Thu ngân nhìn tin trên điện thoại của mình, không cần xem app ngân hàng của chủ.' },
  { title: 'Loa web đọc giao dịch của mọi tài khoản đã nối', body: 'Mở loa web MONA Pay trên máy tính hoặc thiết bị tại quầy. Tiền vào bất kỳ tài khoản ngân hàng nào đã nối đều được đọc; thu ngân nghe báo rồi ghi nhận trên KiotViet.' },
];
const faq = [
  { q: 'KiotViet có loa thông báo thanh toán QR rồi, cần MONA Pay không?', a: 'KiotViet có loa riêng cho giao dịch QR trong hệ thống của họ. MONA Pay dùng cùng KiotViet khi anh chị muốn báo có qua nhóm Zalo, Telegram hoặc loa web cho mọi tài khoản ngân hàng đã nối; không thay thế loa KiotViet.' },
  { q: 'Chưa nối ngân hàng có thử thông báo chuyển khoản tự động không?', a: 'Được. Anh chị tạo tài khoản, thử kênh báo có và kiểm tra luồng webhook trước. Khi nhóm Zalo, Telegram hoặc loa web hoạt động đúng mới nối tài khoản ngân hàng để nhận giao dịch thật.' },
  { q: 'KiotViet nhận chuyển khoản có tự báo có được không?', a: 'Được. Sau khi nối ngân hàng vào MONA Pay, tiền vào là nhóm Zalo, Telegram hoặc loa web báo trong vài giây. Muốn hoá đơn trên KiotViet tự ghi nhận thanh toán thì thêm lớp nối gọi API của KiotViet.' },
  { q: 'Cửa hàng nhiều thu ngân, không muốn đưa app ngân hàng cho họ thì sao?', a: 'Thu ngân xem tin báo có trong nhóm Zalo, Telegram hoặc nghe loa web trên thiết bị tại quầy, không cần đăng nhập tài khoản ngân hàng của chủ. Có thể tách kênh theo chi nhánh hoặc theo từng tài khoản ảo.' },
  { q: 'Ai viết lớp nối KiotViet?', a: `Đội MONA viết cho khách trong vài ngày, hoặc dev của anh chị tự viết theo tài liệu tại monapay.vn/docs. Chi phí lớp nối báo riêng; MONA Pay ${PRICE_LINE}.` },
  { q: 'Tiền có qua KiotViet hay MONA Pay không?', a: 'Không. Tiền vào thẳng tài khoản ACB của anh chị. MONA Pay chỉ đọc thông báo giao dịch từ ACB rồi báo về.' },
  { q: 'Loa thông báo thanh toán QR của MONA Pay có mất phí không?', a: `MONA Pay thu 0% trên giá trị chuyển khoản và ${PRICE_LINE}. Chi phí lớp nối tự ghi nhận hoá đơn trên KiotViet được báo riêng nếu cửa hàng cần đội MONA viết.` },
];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, inLanguage: 'vi', url: SITE.url + '/cong-thanh-toan-kiotviet', author: { '@id': SITE.url + '/#organization' }, publisher: { '@id': SITE.url + '/#organization' }, isPartOf: { '@id': SITE.url + '/#website' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'KiotViet thanh toán chuyển khoản', item: SITE.url + '/cong-thanh-toan-kiotviet' },
  ] },
];
---
<Base title={title} description={description} path="/cong-thanh-toan-kiotviet" jsonld={jsonld}>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">KiotViet · chuyển khoản ACB</span>
      <h1><span class="accent">Thông báo chuyển khoản tự động cho KiotViet:</span><br class="hb" /> loa báo có, nhóm Zalo</h1>
      <div class="answer-first">
        <p>Thông báo chuyển khoản tự động cho KiotViet: loa báo có, nhóm Zalo là cách dùng MONA Pay song song với KiotViet. KiotViet có loa riêng cho QR của họ; MONA Pay báo vào Zalo, Telegram và loa web cho mọi tài khoản ngân hàng đã nối. Muốn hoá đơn tự ghi nhận thì thêm lớp nối.</p>
      </div>
      <p class="lead">{SITE.entity}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={SITE.appRegister}>Tạo tài khoản miễn phí</a>
        <a class="btn btn-outline" href="/chia-se-bien-dong-so-du-telegram">Xem cách báo qua Telegram</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Chuyện cửa hàng dùng KiotViet hay gặp</span>
      <h2>Loa thông báo thanh toán QR dùng cùng KiotViet ra sao?</h2>
      <p class="lead">KiotViet đã có loa riêng cho giao dịch QR trong hệ thống của họ. MONA Pay bổ sung nhóm Zalo, Telegram và loa web để báo tiền vào mọi tài khoản ngân hàng đã nối, kể cả khoản chuyển không đi qua QR của KiotViet.</p>
      <div class="grid grid-3">
        <div class="card"><div class="icon">1</div><h3>Nhiều tài khoản nhận tiền</h3><p>Loa web đọc giao dịch từ mọi tài khoản ngân hàng đã nối. Thu ngân không phải mở từng app ngân hàng để kiểm tra.</p></div>
        <div class="card"><div class="icon">2</div><h3>Nhiều chi nhánh cần cùng thấy báo có</h3><p>Nhóm Zalo hoặc Telegram giúp quản lý và thu ngân cùng thấy số tiền, thời gian, nội dung chuyển khoản.</p></div>
        <div class="card"><div class="icon">3</div><h3>Khoản chuyển ngoài QR KiotViet</h3><p>Khách chuyển theo số tài khoản hoặc VietQR từ kênh khác vẫn có thể được MONA Pay báo vào nhóm và loa web.</p></div>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">Đường tạm, không cần code</span>
      <h2>Báo có chuyển khoản tự động qua Zalo, Telegram và loa web</h2>
      <p class="lead">Cửa hàng có thể tạo tài khoản ảo riêng theo chi nhánh, chọn nhóm nhận tin và mở loa web tại quầy. Tiền vào tài khoản nào thì đúng nhóm và thiết bị đã cấu hình nhận thông báo.</p>
      <div style="margin-top:1.5rem"><Steps items={stepsTam} /></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Đường đầy đủ</span>
      <h2>KiotViet thanh toán chuyển khoản tự ghi nhận qua lớp nối</h2>
      <p class="lead">MONA Pay chưa có ứng dụng cài sẵn cho KiotViet. Hoá đơn tự ghi nhận nhờ lớp nối: nhận webhook, kiểm chữ ký, gọi API của KiotViet. Đội MONA viết cho khách hoặc dev của anh chị tự viết theo tài liệu.</p>
      <div style="margin-top:1.5rem"><Steps items={stepsNoi} /></div>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">So sánh</span>
      <h2>Dùng cùng KiotViet: loa riêng, nhóm báo có và lớp nối</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tiêu chí</th><th>Ví, cổng nội địa thu phần trăm</th><th>Cổng quốc tế (PayPal, Stripe)</th><th>Chuyển khoản VietQR + MONA Pay</th></tr></thead>
          <tbody>
            <tr><td>Phí mỗi giao dịch</td><td>Phần trăm theo hợp đồng, không niêm yết công khai</td><td>PayPal 4,40% + phí cố định; Stripe chưa mở cho doanh nghiệp Việt Nam (kiểm 28/08/2026)</td><td>0đ</td></tr>
            <tr><td>Tiền về đâu</td><td>Ví hoặc tài khoản đối soát rồi mới về ngân hàng</td><td>Số dư cổng, rút về ngân hàng 60.000đ/lần (PayPal)</td><td>Thẳng vào tài khoản ACB</td></tr>
            <tr><td>Khách cần gì</td><td>Ví hoặc app tương ứng</td><td>Thẻ quốc tế</td><td>App ngân hàng bất kỳ</td></tr>
            <tr><td>Hợp với</td><td>Khách đã có sẵn ví</td><td>Khách nước ngoài</td><td>Khách trong nước tại quầy và qua chat</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:1.2rem">Cùng nguyên lý với <a href="/cong-thanh-toan-sapo">Sapo</a>, <a href="/cong-thanh-toan-haravan">Haravan</a> và <a href="/cong-thanh-toan-woocommerce">WooCommerce</a>. Nối ngân hàng xem trang <a href="/acb">ACB</a>, cách viết phần nhận webhook xem <a href="/docs/webhooks/tich-hop-webhook">tài liệu webhook</a>.</p>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <Faq items={faq} eyebrow="Hỏi đáp" title="Chủ cửa hàng dùng KiotViet hay hỏi tụi em" />
    </div>
  </section>

  <CtaBand title="Cửa hàng của anh chị tự báo có từ hôm nay" body="Tạo tài khoản, nối ACB 4 bước, chọn nhóm Zalo hoặc Telegram và mở loa web tại quầy. Cần lớp nối KiotViet thì gọi tụi em." primary={{ href: SITE.appRegister, label: 'Tạo tài khoản miễn phí' }} secondary={{ href: '/docs/bat-dau-nhanh', label: 'Đọc hướng dẫn 5 phút' }} />
</Base>
<style>
  .hb,.br-d{display:inline}
  @media (max-width:767px){.hb,.br-d{display:none}}
  .hero h1{font-size:clamp(1.8rem,3.2vw,2.5rem)}
</style>
