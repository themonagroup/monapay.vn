---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Steps from '../components/Steps.astro';
import { SITE } from '../data/site';
import { PRICE_LINE } from '../data/pricing';

const title = 'KiotViet thanh toán chuyển khoản: tự báo có, khỏi canh app bank';
const description = 'KiotViet thanh toán chuyển khoản với MONA Pay: khách quét VietQR tại quầy, tiền vào thẳng ACB, Telegram báo theo chi nhánh, hoá đơn tự ghi nhận qua lớp nối.';

const stepsNoi = [
  { title: 'Nối ACB vào MONA Pay', body: 'Đăng ký tại my.monapay.vn, dùng ngay. Wizard 4 bước, 2 lần OTP do ACB gửi về số điện thoại chủ tài khoản.' },
  { title: 'Mỗi hoá đơn KiotViet một mã VietQR động', body: 'Lớp nối gọi API tạo QR của MONA Pay khi thu ngân chọn chuyển khoản: số tiền đúng hoá đơn, nội dung là mã hoá đơn. Khách quét ngay tại quầy hoặc qua ảnh gửi trên chat.' },
  { title: 'Webhook có chữ ký về lớp nối', body: 'MONA Pay gửi JSON ký HMAC-SHA256, từ chối gói lệch quá 5 phút. Lớp nối trả HTTP 200 trong 10 giây; lỗi thì dashboard có lịch sử và nút gửi lại.' },
  { title: 'Lớp nối ghi nhận thanh toán trên KiotViet', body: 'Đọc mã hoá đơn, so số tiền, gọi API của KiotViet để ghi nhận đã thanh toán. Đội MONA viết cho khách hoặc dev của anh chị tự viết. Kiểm với KiotViet xem gói đang dùng có mở API không.' },
];
const stepsTam = [
  { title: 'Thu ngân tạo VietQR động trong dashboard MONA Pay', body: 'Nhập số tiền và mã hoá đơn, hiện QR lên màn hình hoặc in ra để khách quét. Không đụng gì tới KiotViet.' },
  { title: 'Tiền vào, Telegram nhóm cửa hàng báo ngay', body: 'Tin về trong vài giây: ngân hàng, số tài khoản, số tiền, thời gian, nội dung. Thu ngân nhìn tin trên điện thoại của chính mình, không cần xem app ngân hàng của chủ.' },
  { title: 'Thu ngân bấm đã thanh toán trên KiotViet', body: 'Vẫn một thao tác tay, nhưng bỏ hẳn chuyện chủ phải đứng cạnh quầy để xác nhận tiền vào.' },
];
const faq = [
  { q: 'KiotViet nhận chuyển khoản có tự báo có được không?', a: 'Được. Nối ACB vào MONA Pay xong, tiền vào là Telegram nhóm cửa hàng nhận tin trong vài giây. Muốn hoá đơn trên KiotViet tự ghi nhận thanh toán thì thêm lớp nối gọi API của KiotViet.' },
  { q: 'Cửa hàng nhiều thu ngân, không muốn đưa app ngân hàng cho họ thì sao?', a: 'Đây là lý do nhiều khách MONA dùng Telegram: thu ngân nhìn tin báo tiền vào trên điện thoại của mình, không cần đăng nhập tài khoản ngân hàng của chủ. Có thể tách nhóm theo chi nhánh hoặc theo từng tài khoản ảo.' },
  { q: 'Ai viết lớp nối KiotViet?', a: 'Đội MONA viết cho khách trong vài ngày, hoặc dev của anh chị tự viết theo tài liệu tại monapay.vn/docs. Chi phí lớp nối báo riêng, MONA Pay vẫn miễn phí.' },
  { q: 'Tiền có qua KiotViet hay MONA Pay không?', a: 'Không. Tiền vào thẳng tài khoản ACB của anh chị. MONA Pay chỉ đọc thông báo giao dịch từ ACB rồi báo về.' },
  { q: 'Phí bao nhiêu?', a: `MONA Pay ${PRICE_LINE}. Không phần trăm, không phí rút. Để đối chiếu, PayPal Việt Nam thu 4,40% cộng phí cố định và 60.000đ mỗi lần rút về ngân hàng trong nước (biểu phí công bố, kiểm 28/08/2026).` },
];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, inLanguage: 'vi', url: SITE.url + '/cong-thanh-toan-kiotviet', author: { '@id': SITE.url + '/#organization' }, publisher: { '@id': SITE.url + '/#organization' }, isPartOf: { '@id': SITE.url + '/#website' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'KiotViet thanh toán chuyển khoản', item: SITE.url + '/cong-thanh-toan-kiotviet' },
  ] },
];
---
<Base title={title} description={description} path="/cong-thanh-toan-kiotviet" jsonld={jsonld}>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">KiotViet · chuyển khoản ACB</span>
      <h1>KiotViet thanh toán chuyển khoản:<br class="hb" /> <span class="accent">tự báo có, khỏi canh app ngân hàng</span></h1>
      <div class="answer-first">
        <p>KiotViet thanh toán chuyển khoản với MONA Pay chạy thế này: thu ngân tạo mã VietQR động đúng số tiền hoá đơn, khách quét app ngân hàng, tiền vào thẳng tài khoản ACB của anh chị, Telegram nhóm cửa hàng báo trong vài giây, muốn hoá đơn tự ghi nhận thanh toán thì thêm lớp nối. Miễn phí 500 giao dịch mỗi tháng, không phần trăm.</p>
      </div>
      <p class="lead">{SITE.entity}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={SITE.appRegister}>Tạo tài khoản miễn phí</a>
        <a class="btn btn-outline" href="/chia-se-bien-dong-so-du-telegram">Xem cách báo qua Telegram</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Chuyện cửa hàng dùng KiotViet hay gặp</span>
      <h2>Khách chuyển khoản tại quầy,<br class="br-d" /> chủ phải đứng đó xác nhận</h2>
      <p class="lead">Cửa hàng bán lẻ dùng KiotViet mà khách MONA hay kể: khách quét chuyển khoản xong, thu ngân không có quyền xem tài khoản ngân hàng nên phải gọi chủ, chủ mở app xem tiền vào chưa rồi mới cho lấy hàng. Giờ cao điểm là ùn ở quầy.</p>
      <div class="grid grid-3">
        <div class="card"><div class="icon">1</div><h3>Chủ thành người xác nhận tiền</h3><p>Mỗi giao dịch chuyển khoản là một cuộc gọi hoặc một lần chủ phải nhìn điện thoại. Chủ đi vắng là quầy đứng.</p></div>
        <div class="card"><div class="icon">2</div><h3>Nhiều chi nhánh, một tài khoản</h3><p>Ba chi nhánh cùng nhận vào một số tài khoản, nhìn biến động không biết tiền của quầy nào. Cuối ngày đối soát mất cả tiếng.</p></div>
        <div class="card"><div class="icon">3</div><h3>Khách gửi ảnh biên lai giả</h3><p>Ảnh chuyển khoản chỉnh sửa không hiếm. Chỉ có thông báo từ ngân hàng về đúng số tiền mới là bằng chứng.</p></div>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">Đường tạm, không cần code</span>
      <h2>Bắt đầu ngay hôm nay:<br class="br-d" /> VietQR động cộng Telegram</h2>
      <p class="lead">Với cửa hàng bán lẻ, đường này giải quyết được phần nặng nhất là chủ không phải đứng canh tiền. Tạo tài khoản ảo riêng cho từng chi nhánh, mỗi chi nhánh một nhóm Telegram, tiền vào quầy nào nhóm đó báo.</p>
      <div style="margin-top:1.5rem"><Steps items={stepsTam} /></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Đường đầy đủ</span>
      <h2>Lớp nối với KiotViet<br class="br-d" /> tự ghi nhận thanh toán trên hoá đơn</h2>
      <p class="lead">MONA Pay chưa có ứng dụng cài sẵn cho KiotViet. Hoá đơn tự ghi nhận nhờ lớp nối: nhận webhook, kiểm chữ ký, gọi API của KiotViet. Đội MONA viết cho khách hoặc dev của anh chị tự viết theo tài liệu.</p>
      <div style="margin-top:1.5rem"><Steps items={stepsNoi} /></div>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">So sánh</span>
      <h2>Ba cách nhận tiền cho cửa hàng dùng KiotViet</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tiêu chí</th><th>Ví, cổng nội địa thu phần trăm</th><th>Cổng quốc tế (PayPal, Stripe)</th><th>Chuyển khoản VietQR + MONA Pay</th></tr></thead>
          <tbody>
            <tr><td>Phí mỗi giao dịch</td><td>Phần trăm theo hợp đồng, không niêm yết công khai</td><td>PayPal 4,40% + phí cố định; Stripe chưa mở cho doanh nghiệp Việt Nam (kiểm 28/08/2026)</td><td>0đ</td></tr>
            <tr><td>Tiền về đâu</td><td>Ví hoặc tài khoản đối soát rồi mới về ngân hàng</td><td>Số dư cổng, rút về ngân hàng 60.000đ/lần (PayPal)</td><td>Thẳng vào tài khoản ACB</td></tr>
            <tr><td>Khách cần gì</td><td>Ví hoặc app tương ứng</td><td>Thẻ quốc tế</td><td>App ngân hàng bất kỳ</td></tr>
            <tr><td>Hợp với</td><td>Khách đã có sẵn ví</td><td>Khách nước ngoài</td><td>Khách trong nước tại quầy và qua chat</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:1.2rem">Cùng nguyên lý với <a href="/cong-thanh-toan-sapo">Sapo</a>, <a href="/cong-thanh-toan-haravan">Haravan</a> và <a href="/cong-thanh-toan-woocommerce">WooCommerce</a>. Nối ngân hàng xem trang <a href="/acb">ACB</a>, cách viết phần nhận webhook xem <a href="/docs/webhooks/tich-hop-webhook">tài liệu webhook</a>.</p>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <Faq items={faq} eyebrow="Hỏi đáp" title="Chủ cửa hàng dùng KiotViet hay hỏi tụi em" />
    </div>
  </section>

  <CtaBand title="Cửa hàng của anh chị tự báo có từ hôm nay" body="Tạo tài khoản, nối ACB 4 bước, lập nhóm Telegram cho từng chi nhánh. Cần lớp nối KiotViet thì gọi tụi em." primary={{ href: SITE.appRegister, label: 'Tạo tài khoản miễn phí' }} secondary={{ href: '/docs/bat-dau-nhanh', label: 'Đọc hướng dẫn 5 phút' }} />
</Base>
<style>
  .hb,.br-d{display:inline}
  @media (max-width:767px){.hb,.br-d{display:none}}
  .hero h1{font-size:clamp(1.8rem,3.2vw,2.5rem)}
</style>
