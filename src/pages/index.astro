// Thứ tự: hero (báo có tự động, miễn phí) → cảnh quen ở shop → công dụng → cách chạy → không có web vẫn dùng → ai dùng → vì sao miễn phí → tiền không qua MONA Pay → chuyện MONA → khối dev/AI → FAQ → CTA.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import MonaStory from '../components/MonaStory.astro';
import MonaScale from '../components/MonaScale.astro';
import MonaVisit from '../components/MonaVisit.astro';
import MonaFreeBanner from '../components/MonaFreeBanner.astro';
import Steps from '../components/Steps.astro';
import Stats from '../components/Stats.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { SITE } from '../data/site';
import { BANKS_LINE, BANKS_SHORT, LIVE_BANKS } from '../data/banks';
import { PRICING_MODE, FREE_TX_PER_MONTH, PRICE_LINE, PAID_PLANS, CHEAPEST_PAID, YEARLY_MONTHS, FREE_MULTIPLE_LINE, fmt, fmtVnd } from '../data/pricing';
import { AI_PROMPT, CURL_SAMPLE, PHP_SAMPLE, NODE_SAMPLE } from '../data/home-samples';
const isFree = PRICING_MODE === 'free-all';
const priceCap = PRICE_LINE.charAt(0).toUpperCase() + PRICE_LINE.slice(1);
const liveBank = LIVE_BANKS[0]?.name ?? 'ACB';

const title = 'Cổng thanh toán tự động báo có chuyển khoản, miễn phí | MONA Pay';
const description = `Cổng thanh toán tự động báo có MONA Pay: khách chuyển khoản là website, phần mềm, Telegram và email biết ngay, đơn tự xác nhận. ${isFree ? 'Miễn phí, không giới hạn giao dịch.' : `Miễn phí ${FREE_TX_PER_MONTH} giao dịch/tháng.`}`;

const stats = [
  { value: String(SITE.founded), label: 'năm The MONA Group thành lập, hơn 10 năm làm web và phần mềm' },
  { value: SITE.projects, label: 'dự án đã giao cho khách hàng' },
  { value: SITE.customersSince2022, label: 'khách hàng mới của MONA thu tiền qua hệ thống này từ 2022 tới nay' },
  isFree ? { value: '0 đ', label: 'miễn phí, không giới hạn giao dịch, đủ tính năng' } : { value: String(FREE_TX_PER_MONTH), label: 'giao dịch mỗi tháng miễn phí, đủ tính năng' },
];

const pains = [
  { t: 'Khách nhắn "chuyển rồi nha", nhân viên mở app ngân hàng dò', d: 'Mỗi ngày vài chục lần mở app, kéo sao kê, so số tiền với đơn. Ba khách chuyển cùng số tiền thì phải hỏi lại từng người. Shop nào bán chạy là có một nhân viên gần như chỉ ngồi làm việc này.' },
  { t: 'Nội dung chuyển khoản mỗi khách gõ một kiểu', d: 'Người ghi mã đơn, người ghi "ck", người ghi tên mình, người để trống. Cuối ngày kế toán ngồi ghép sao kê với danh sách đơn, ghép không ra thì gọi khách hỏi lại.' },
  { t: 'Khách chuyển lúc 11 giờ đêm, sáng hôm sau mới có người xác nhận', d: 'Đơn nằm chờ 8 tiếng, khách nhắn hỏi, kho không dám đóng hàng. Bán qua Facebook, Zalo, TikTok thì ai cũng biết: khách chờ lâu là huỷ đơn, đặt chỗ khác.' },
  { t: 'Nhận ảnh bill chuyển khoản, giao hàng xong mới biết chưa có tiền', d: 'Ảnh chụp màn hình sửa được. Nhân viên tin ảnh, giao hàng, tối kiểm sao kê mới thấy không có khoản nào. Hàng đã đi, tiền không về, không biết đòi ai.' },
];

const uses = [
  { k: '01', t: 'Báo có tức thì vào nhóm Telegram của cửa hàng', d: 'Tiền vào tài khoản là 1 tin nhắn hiện trong nhóm: ngân hàng, số tiền, nội dung, giờ chuyển. Chủ shop, kế toán, nhân viên chốt đơn cùng thấy một lúc, không ai phải cầm điện thoại có app ngân hàng. Mẫu tin sửa được, ví dụ chỉ hiện số tiền và mã đơn.' },
  { k: '02', t: 'Đơn hàng tự chuyển sang "đã thanh toán"', d: 'Website hay phần mềm bán hàng nhận tín hiệu từ MONA Pay rồi tự đổi trạng thái đơn, tự gửi email xác nhận, tự đẩy đơn xuống kho. Khách chuyển lúc 11 giờ đêm thì 11 giờ 1 phút đơn đã xác nhận, không cần ai thức canh.' },
  { k: '03', t: 'Mỗi đơn 1 mã QR đúng số tiền, đúng nội dung', d: 'Anh chị tạo mã VietQR cho từng đơn, khách quét là app ngân hàng điền sẵn số tiền và mã đơn, không gõ tay. Hết cảnh khách chuyển thiếu 50.000 đ hay ghi nội dung "chuyen tien". Tạo trong dashboard, hoặc website tự tạo lúc khách đặt hàng.' },
  { k: '04', t: 'Mỗi khách 1 số tài khoản riêng để nhận tiền', d: 'Ngân hàng cấp cho anh chị một dải số tài khoản ảo, MONA Pay gắn mỗi số cho 1 khách hoặc 1 đơn. Tiền vào số nào là biết của ai ngay, không cần đọc nội dung. Hợp với thu học phí, tiền trọ, phí hội viên, tiền cọc: khách chuyển tháng nào cũng đúng số đó.' },
  { k: '05', t: 'Chỉ tin ngân hàng, không tin ảnh chụp màn hình', d: 'MONA Pay nhận thông tin thẳng từ ngân hàng, có tiền thật vào tài khoản mới báo. Nhân viên không cần nhìn bill khách gửi để quyết định giao hàng, cứ chờ tin trong nhóm hoặc trạng thái đơn trên phần mềm.' },
  { k: '06', t: 'Sổ giao dịch xem mọi lúc, xuất file cho kế toán', d: 'Mọi khoản tiền vào nằm trong dashboard my.monapay.vn: lọc theo ngày, theo tài khoản, xuất file CSV để đối chiếu cuối tháng. Mở được trên máy tính lẫn điện thoại, bật xác thực 2 lớp cho tài khoản quản trị.' },
];

const steps = [
  { title: 'Khách chuyển khoản như bình thường', body: 'Khách quét mã QR hoặc chuyển vào số tài khoản anh chị đưa. Tiền vào thẳng tài khoản ngân hàng đứng tên anh chị, không qua ví, không qua trung gian nào.' },
  { title: 'Ngân hàng báo cho MONA Pay ngay khi tiền vào', body: 'Anh chị cho phép MONA Pay nhận thông báo giao dịch từ ngân hàng, làm 1 lần trong dashboard, xác nhận bằng 2 mã OTP ngân hàng gửi về điện thoại. Từ đó tiền vừa chạm tài khoản là ngân hàng đẩy thông tin sang: số tiền, nội dung, mã giao dịch.' },
  { title: 'MONA Pay báo về đúng chỗ anh chị chọn', body: 'Nhóm Telegram nhận tin nhắn, người nhận đã xác minh nhận email. Website, phần mềm bán hàng nhận một gói tin có chữ ký bảo mật để biết chắc tin do MONA Pay gửi. Cả 3 kênh chạy cùng lúc, trong vài giây.' },
  { title: 'Phần mềm tự khớp đơn, người chỉ việc giao hàng', body: 'Phần mềm so mã đơn hoặc số tài khoản nhận để biết tiền này của đơn nào rồi tự xác nhận. Người bán chỉ còn việc đóng gói và giao. Cuối tháng kế toán mở sổ giao dịch đối chiếu, khỏi ghép sao kê bằng tay.' },
];

const noWeb = [
  { t: `Tài khoản ngân hàng ${liveBank} đứng tên anh chị`, d: `Cá nhân hay doanh nghiệp đều nối được. ${liveBank} là ngân hàng hệ thống này chạy thật từ 2022, các ngân hàng khác đang kết nối thêm, xem bảng trạng thái ở trang ngân hàng hỗ trợ.` },
  { t: 'Nhóm Telegram của cửa hàng', d: 'Thêm bot MONA Pay vào nhóm, chọn tài khoản muốn theo dõi. Từ đó tiền vào là cả nhóm thấy, ai đi vắng cũng không lỡ đơn.' },
  { t: 'Khoảng 10 phút làm theo hướng dẫn', d: `Tạo tài khoản, nối ngân hàng bằng 2 mã OTP, thêm bot vào nhóm. Không cài phần mềm, không cần biết lập trình. Kẹt chỗ nào gọi ${SITE.hotline}, tụi em ngồi cùng tới khi chạy.` },
];

const industries = [
  { href: '/cong-thanh-toan-woocommerce', t: 'Shop, website bán hàng', d: 'WordPress, WooCommerce, Shopify, Haravan, Sapo, KiotViet: khách chuyển khoản là đơn tự xác nhận, kho đóng hàng ngay, không chờ người kiểm.' },
  { href: '/nganh/giao-duc', t: 'Trung tâm, trường, khoá học online', d: 'Mỗi học viên 1 số tài khoản riêng, đóng học phí là hệ thống ghi nhận và mở khoá bài học, kế toán không dò tên từng người.' },
  { href: '/nganh/nha-hang-fnb', t: 'Nhà hàng, quán cà phê', d: 'Mã QR đúng số tiền cho từng hoá đơn, thu ngân thấy tiền vào ngay trên máy, không cần khách chìa màn hình.' },
  { href: '/nganh/spa-salon', t: 'Spa, salon, phòng khám', d: 'Khách chuyển cọc là lịch hẹn tự giữ chỗ, lễ tân không phải mở app ngân hàng kiểm rồi mới xác nhận lịch.' },
  { href: '/nganh/cho-thue-tro', t: 'Cho thuê trọ, căn hộ', d: 'Mỗi phòng 1 số tài khoản, tiền nhà tháng nào cũng khớp đúng phòng đó, chủ trọ mở sổ là biết ai chưa đóng.' },
  { href: '/nganh/nhap-hang-trung-quoc', t: 'Đặt hàng hộ, nhập hàng Trung Quốc', d: 'Khách nạp tiền là số dư trong phần mềm tự cộng, không phải gửi bill rồi chờ nhân viên đối chiếu.' },
];

const faq = [
  { q: 'Tôi không rành kỹ thuật, tự dùng được không?', a: `Được. Phần nhận báo có qua Telegram không cần viết dòng code nào: tạo tài khoản, nối ngân hàng bằng 2 mã OTP, thêm bot vào nhóm, làm theo hướng dẫn trong dashboard khoảng 10 phút. Phần nối vào website hay phần mềm thì lập trình viên của anh chị làm 1 lần theo code mẫu, web làm tại MONA thì tụi em cài luôn. Kẹt chỗ nào gọi ${SITE.hotline}.` },
  { q: 'Tiền của khách có đi qua MONA Pay không?', a: 'Không. Khách chuyển thẳng vào tài khoản ngân hàng đứng tên anh chị. MONA Pay chỉ nhận thông báo giao dịch từ ngân hàng rồi báo lại cho phần mềm, nhóm Telegram, email và dashboard. Tụi em không giữ tiền, không chạm vào tiền, nên không có chuyện chờ đối soát rồi mới được rút.' },
  { q: 'Miễn phí thật không, có phí ẩn không?', a: isFree ? `${priceCap}, đủ mọi tính năng: tài khoản ảo, mã QR, báo Telegram, nối website, sổ giao dịch. Không thu phần trăm trên số tiền, không phí mở tài khoản, không phí theo tháng. Phí duy nhất anh chị có thể gặp là phí ngân hàng thu cho tài khoản của mình, nếu có, MONA không thu thêm gì. Điều khoản ghi rõ: nếu sau này có gói thu phí, tụi em báo trước ít nhất 30 ngày và tài khoản đang dùng không bị tự chuyển sang trả phí.` : `Miễn phí ${FREE_TX_PER_MONTH} giao dịch mỗi tháng, đủ mọi tính năng. Vượt mức đó có gói trả phí tính theo số giao dịch, niêm yết công khai ở trang bảng giá. Không thu phí theo phần trăm số tiền. Riêng anh chị đang là khách hàng của MONA (web, phần mềm, hosting) thì miễn phí hoàn toàn, không giới hạn giao dịch, gọi ${SITE.hotline} để đội MONA gán gói.` },
  { q: 'Cần tài khoản ngân hàng nào?', a: `${BANKS_LINE}. Tài khoản cá nhân hay doanh nghiệp đều nối được. Bảng trạng thái từng ngân hàng cập nhật tại <a href="/ngan-hang">trang ngân hàng hỗ trợ</a>; Telegram, website, sổ giao dịch dùng chung nên thêm ngân hàng anh chị không phải làm lại gì.` },
  { q: 'Tôi chỉ bán qua Facebook, Zalo, chưa có website, dùng được không?', a: `Được. Anh chị chỉ cần tài khoản ngân hàng và một nhóm Telegram: tiền vào là nhóm có tin, khỏi mở app ngân hàng kiểm. Cần mã QR đúng số tiền cho từng đơn thì tạo trong dashboard, hoặc dùng <a href="/tao-ma-qr-ngan-hang">tool tạo mã QR ngân hàng</a> miễn phí trên monapay.vn, không cần đăng nhập. Sau này làm website thì nối thêm, tài khoản vẫn giữ nguyên.` },
  { q: 'Đăng ký xong dùng ngay được không?', a: 'Được. Tài khoản tự kích hoạt ngay khi tạo, không cần ai duyệt. Anh chị đăng nhập, nối ngân hàng bằng 2 mã OTP, thêm bot Telegram hoặc nối website, tất cả tự làm trong vài phút.' },
  { q: 'Website của tôi không do MONA làm, có nối được không?', a: 'Được. MONA Pay báo cho website bằng một gói tin HTTP thông thường tới đường dẫn anh chị chỉ định, phần mềm nào nhận được yêu cầu từ internet là nhận được. WordPress, WooCommerce, Laravel, Node, .NET, phần mềm nội bộ tự viết đều nối được, có code mẫu trong tài liệu để lập trình viên copy.' },
  { q: 'Lỡ báo hụt thì có mất giao dịch không?', a: 'Không mất. Mọi giao dịch ngân hàng báo về đều được ghi trong dashboard, kể cả khi website của anh chị đang tắt. Mỗi lần gửi tin về website đều có lịch sử, gửi hụt thì bấm gửi lại ngay trong dashboard. Gửi lại tự động theo lịch, tối đa 7 lần, đang được triển khai, tụi em công bố tại tài liệu khi lên.' },
];

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: 'MONA Pay', applicationCategory: 'FinanceApplication', operatingSystem: 'Web',
  url: SITE.url, description: SITE.entity, inLanguage: 'vi',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'VND', description: isFree ? 'Miễn phí, không giới hạn giao dịch, đủ tính năng' : `Miễn phí ${FREE_TX_PER_MONTH} giao dịch/tháng, đủ tính năng` },
  featureList: ['Báo có tự động khi khách chuyển khoản', 'Thông báo Telegram', 'Thông báo email đã xác minh người nhận', 'Đơn hàng tự xác nhận qua webhook ký HMAC-SHA256', 'VietQR động theo đơn', 'Tài khoản ảo (VA) theo khách', 'Dashboard sổ giao dịch, xuất CSV', 'API v1 + OpenAPI + llms.txt'],
  softwareHelp: { '@type': 'CreativeWork', url: SITE.docs },
  publisher: { '@id': SITE.url + '/#organization' },
}];
---
<Base title={title} description={description} path="/" jsonld={jsonld} alternate={{ vi: '/', en: '/en' }}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Cho doanh nghiệp kinh doanh online · The MONA Group</span>
        <h1>Cổng thanh toán tự động báo có<br class="br-d" /> <span class="accent">miễn phí cho doanh nghiệp online</span></h1>
        <div class="answer-first">
          <p>MONA Pay là cổng thanh toán tự động báo có bằng chuyển khoản ngân hàng: khách chuyển tiền vào tài khoản ngân hàng của anh chị, tiền vừa vào là MONA Pay báo ngay về website, phần mềm bán hàng, nhóm Telegram và email đã xác minh, đơn tự chuyển sang đã thanh toán.</p>
          <p>{priceCap}, không thu phần trăm trên số tiền. Tiền vẫn nằm trong tài khoản ngân hàng đứng tên anh chị, MONA Pay không giữ tiền.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href={SITE.appRegister}>Tạo tài khoản miễn phí</a>
          <a class="btn btn-outline" href="#cach-hoat-dong">Xem cách hoạt động</a>
        </div>
        <p class="hero-note">Đăng ký xong dùng ngay · Không cần biết lập trình · Tổng đài <a href={SITE.hotlineTel}>{SITE.hotline}</a></p>
      </div>
      <div class="demo card" aria-label="Minh hoạ một giao dịch tiền vào được MONA Pay báo về">
        <div class="demo-head"><span class="badge badge-ok">Tiền vào {liveBank}</span><span class="demo-tag">minh hoạ</span></div>
        <div class="demo-amount">+2.500.000 đ</div>
        <div class="demo-row"><span>Nội dung</span><b>DH10234 NGUYEN VAN A</b></div>
        <div class="demo-row"><span>Tài khoản nhận</span><b>Số tài khoản riêng của đơn DH10234</b></div>
        <div class="demo-row"><span>Mã giao dịch</span><b>FT26240001234</b></div>
        <div class="demo-row"><span>Thời gian</span><b>23:02:15 · 29/08/2026</b></div>
        <div class="demo-log">
          <span class="badge badge-cta">Telegram · nhóm Chốt đơn đã nhận</span>
          <span class="badge badge-ok">Website · đơn DH10234 đã thanh toán</span>
          <span class="badge">Kho · bắt đầu đóng hàng</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <div class="stats-5"><Stats items={stats} /></div>
      <p class="stats-note">{SITE.trustLine}</p>
    </div>
  </section>

  <MonaScale />

  <section>
    <div class="wrap">
      <span class="eyebrow">Chuyện quen ở shop online</span>
      <h2>Anh chị có đang tự tay<br class="br-d" /> xác nhận từng đơn chuyển khoản?</h2>
      <p class="lead">Bán hàng online, khách trả bằng chuyển khoản là chính. Tiền về ngân hàng rồi, nhưng để biết tiền đó của đơn nào thì vẫn phải có người làm tay. Tụi em gặp đúng 4 cảnh này ở hầu hết khách tới MONA làm web bán hàng.</p>
      <div class="grid grid-2 pains">
        {pains.map((p, i) => (
          <div class="card pain">
            <div class="icon">{i + 1}</div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
      <p class="pain-close">Ngân hàng nào cũng có tin nhắn báo có, nhưng tin đó nằm trong điện thoại của một người, còn đơn hàng nằm ở website, ở phần mềm, ở nhóm chốt đơn. MONA Pay nối hai bên lại: ngân hàng báo có là mọi chỗ cần biết đều biết.</p>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">Công dụng</span>
      <h2>MONA Pay làm gì cho anh chị<br class="br-d" /> mỗi ngày</h2>
      <p class="lead">Tất cả xoay quanh một việc: tiền vừa vào tài khoản ngân hàng là mọi chỗ cần biết đều biết ngay, không cần người đi kiểm tra. Từ đó ra 6 việc cụ thể dưới đây.</p>
      <div class="grid grid-3">
        {uses.map((f) => (
          <div class="card">
            <div class="icon">{f.k}</div>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
      <figure class="photo home-dashboard-proof">
        <picture>
          <source srcset="/img/dashboard/overview.avif" type="image/avif" />
          <source srcset="/img/dashboard/overview.webp" type="image/webp" />
          <img src="/img/dashboard/overview.png" width="1280" height="860" loading="lazy" decoding="async" alt="Dashboard MONA Pay tổng quan tài chính với API key, kích hoạt tài khoản và tạo tài khoản ảo" />
        </picture>
        <figcaption>Màn hình Tổng quan cho thấy API key, trạng thái kích hoạt và các bước bắt đầu nhận giao dịch, ảnh chụp từ dashboard my.monapay.vn.</figcaption>
      </figure>
    </div>
  </section>

  <section id="cach-hoat-dong">
    <div class="wrap">
      <span class="eyebrow">Hoạt động thế nào</span>
      <h2>Từ lúc khách chuyển khoản<br class="br-d" /> tới lúc đơn tự đổi trạng thái</h2>
      <p class="lead">4 bước, không bước nào cần người ngồi kiểm tra. Anh chị cần có tài khoản ngân hàng và một chỗ để nhận tin: nhóm Telegram, website hay phần mềm quản lý, có cái nào dùng cái đó.</p>
      <Steps items={steps} />
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">Bán qua Facebook, Zalo, TikTok</span>
      <h2>Chưa có website<br class="br-d" /> vẫn dùng được ngay</h2>
      <p class="lead">Nhiều anh chị bán qua Facebook, Zalo, TikTok, chưa có website hay phần mềm nào. Vẫn dùng được, chỉ cần 3 thứ:</p>
      <div class="grid grid-3">
        {noWeb.map((n, i) => (
          <div class="card">
            <div class="icon">{i + 1}</div>
            <h3>{n.t}</h3>
            <p>{n.d}</p>
          </div>
        ))}
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={SITE.appRegister}>Tạo tài khoản miễn phí</a>
        <a class="btn btn-outline" href="/docs/dung-ngay">Hướng dẫn cho chủ quán</a>
        <a class="btn btn-ghost" href="/chia-se-bien-dong-so-du-telegram">Báo có qua Telegram</a>
        <a class="btn btn-ghost" href="/tao-ma-qr-ngan-hang">Tool tạo mã QR ngân hàng</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Ai đang dùng</span>
      <h2>Mỗi ngành dùng MONA Pay<br class="br-d" /> vào một việc khác nhau</h2>
      <p class="lead">Cùng một cách chạy, nhưng mỗi ngành cần một kiểu khớp tiền. Tụi em đã gặp đủ các kiểu này trong web và phần mềm giao cho khách, bấm vào từng ngành để xem cách làm cụ thể.</p>
      <div class="grid grid-3">
        {industries.map((n) => (
          <a class="card ind" href={n.href}>
            <h3>{n.t}</h3>
            <p>{n.d}</p>
            <span class="ind-more">Xem cách làm cho ngành này</span>
          </a>
        ))}
      </div>
      <p class="ind-note">Chính MONA cũng thu tiền bằng hệ thống này: phí hosting ở mona.host, học phí Khánh Hùng Academy, đơn phần mềm Mona.Software. <a href="/khach-hang">Xem các ca dùng thật</a>.</p>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <span class="eyebrow">Giá</span>
      <h2>Miễn phí {fmt(FREE_TX_PER_MONTH)} giao dịch mỗi tháng,<br class="br-d" /> không thu phần trăm trên số tiền</h2>
      <MonaFreeBanner />
      <div class="grid grid-2 why">
        <div>
          <p>Gói Miễn phí có đủ mọi thứ: tài khoản ảo, mã QR, báo Telegram, nối website, sổ giao dịch, API, và {fmt(FREE_TX_PER_MONTH)} giao dịch tiền vào mỗi tháng, {FREE_MULTIPLE_LINE}. Không phí mở tài khoản, không thu phần trăm trên số tiền. Shop bán đều 15 đơn mỗi ngày dùng cả năm không mất đồng nào.</p>
          <p>Bán nhiều hơn {fmt(FREE_TX_PER_MONTH)} giao dịch mỗi tháng, anh chị chọn gói trả phí từ {fmtVnd(CHEAPEST_PAID.price_month)} mỗi tháng cho {fmt(PAID_PLANS[0].tx_limit)} giao dịch, tính theo số giao dịch chứ không theo số tiền, trả năm chỉ tính {YEARLY_MONTHS} tháng. Tụi em giữ giá thấp được vì MONA Pay không giữ tiền nên không có chi phí xử lý tiền, và hệ thống này đã xây từ 2022 để thu tiền cho chính MONA rồi nhúng vào web, phần mềm giao cho hơn 6.000 khách hàng mới của MONA. Máy chủ và đội kỹ thuật đã có sẵn.</p>
          <p><a href="/bang-gia">Xem trang bảng giá</a> để đọc đủ 5 gói, cách đếm giao dịch và chuyện vượt mức thì sao.</p>
        </div>
        <div class="card compare">
          <h3>Để anh chị so với cổng quốc tế</h3>
          <p>PayPal thu <b>4,40%</b> mỗi giao dịch cộng phí cố định, rút tiền về ngân hàng Việt Nam thêm <b>60.000 đ</b> mỗi lần. Stripe tới ngày 28/08/2026 vẫn chưa mở đăng ký cho doanh nghiệp tại Việt Nam.</p>
          <p>Hai bài toán khác nhau: cổng quốc tế để nhận thẻ từ khách nước ngoài, MONA Pay để nhận chuyển khoản trong nước, <b>0 đ</b> tới {fmt(FREE_TX_PER_MONTH)} giao dịch mỗi tháng và không bao giờ thu phần trăm. Bán trong nước thì dùng MONA Pay là đủ.</p>
          <a class="btn btn-outline" href="/cong-thanh-toan-quoc-te">So với cổng thanh toán quốc tế</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">An toàn</span>
      <h2>Tiền vẫn nằm ở ngân hàng<br class="br-d" /> của anh chị</h2>
      <div class="grid grid-2 safe">
        <div>
          <p>Cổng thanh toán thông thường đứng giữa: tiền khách vào tài khoản của cổng, sau đó cổng mới chuyển lại cho anh chị và trừ phí. MONA Pay làm khác. Khách chuyển thẳng vào tài khoản ngân hàng đứng tên anh chị, MONA Pay chỉ đọc thông báo giao dịch mà ngân hàng gửi sang rồi báo lại. Tụi em không giữ tiền, không chạm vào tiền, nên không có chuyện chờ đối soát mới được rút. Một ngày anh chị ngừng dùng MONA Pay, tiền và tài khoản ngân hàng vẫn y nguyên.</p>
          <p>{SITE.entity}</p>
        </div>
        <ul class="safe-list">
          <li><b>Không cần mật khẩu ngân hàng.</b> Nối tài khoản bằng số tài khoản, số điện thoại đăng ký với ngân hàng và 2 mã OTP ngân hàng gửi về. MONA Pay không đăng nhập được app ngân hàng của anh chị.</li>
          <li><b>Tin gửi về website có chữ ký bảo mật.</b> Phần mềm của anh chị kiểm chữ ký để biết chắc tin do MONA Pay gửi, tin cũ quá 5 phút bị từ chối, không ai giả được lệnh "đã thanh toán".</li>
          <li><b>Tài khoản quản trị có xác thực 2 lớp.</b> Bật trong dashboard, đăng nhập cần thêm mã từ điện thoại.</li>
          <li><b>Ngân hàng: {BANKS_SHORT}.</b> Bảng trạng thái từng ngân hàng ở <a href="/ngan-hang">trang ngân hàng hỗ trợ</a>, tình trạng hệ thống ở <a href="/status">trang trạng thái</a>.</li>
        </ul>
      </div>
      <div class="vow-band">
        <p class="vow-line">Dữ liệu giao dịch của anh chị chỉ dùng để báo có cho chính anh chị. MONA không bao giờ tiết lộ, không bán, không đưa cho bên thứ ba.</p>
        <a class="btn btn-outline" href="/cam-ket-bao-mat">Đọc cam kết bảo mật của MONA Pay</a>
      </div>
    </div>
  </section>

  <MonaStory />

  <section class="section-dark">
    <div class="wrap">
      <span class="eyebrow">Có lập trình viên, hoặc dùng AI</span>
      <h2>Nối vào website, phần mềm<br class="br-d" /> trong vài phút</h2>
      <p class="lead">Phần này cho lập trình viên của anh chị, hoặc cho AI. Tài liệu MONA Pay viết cho cả người lẫn máy đọc: mỗi trang có bản .md, có <a href="/llms.txt">llms.txt</a> và <a href="/openapi.json">openapi.json</a> ngay trên monapay.vn. Dán prompt dưới đây vào Claude Code, Codex hay Cursor, AI tự viết phần nhận tin, kiểm chữ ký và khớp đơn.</p>
      <div class="ai-badges">
        <span class="badge">llms.txt ready</span>
        <span class="badge">.md cho mọi trang tài liệu</span>
        <span class="badge">openapi.json</span>
        <span class="badge">HMAC-SHA256 · chống replay 5 phút</span>
      </div>
      <div class="prompt-box">
        <div class="prompt-head"><b>Prompt cho AI agent</b><button type="button" class="copy" data-copy-prompt>Sao chép prompt</button></div>
        <pre id="ai-prompt">{AI_PROMPT}</pre>
      </div>
      <h3 class="ai-h3">Code mẫu nhận webhook, thứ tự cURL, PHP, Node</h3>
      <CodeTabs tabs={[
        { label: 'cURL (test tại chỗ)', lang: 'bash', code: CURL_SAMPLE },
        { label: 'PHP', lang: 'php', code: PHP_SAMPLE },
        { label: 'Node (Express)', lang: 'js', code: NODE_SAMPLE },
      ]} />
      <div class="btn-row">
        <a class="btn btn-primary" href="/docs/bat-dau-nhanh">Bắt đầu nhanh trong 5 phút</a>
        <a class="btn btn-outline" href="/ai-agent">Trang hướng dẫn cho AI agent</a>
        <a class="btn btn-ghost" href="/docs">Xem tài liệu tích hợp</a>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap narrow">
      <Faq items={faq} eyebrow="Hỏi nhanh" title="8 câu anh chị hay hỏi trước khi dùng" />
      <p style="margin-top:1rem"><a href="/faq">Xem đủ 20 câu hỏi thường gặp</a></p>
    </div>
  </section>

  <MonaVisit />

  <CtaBand title="Nối ngân hàng hôm nay, từ mai đơn tự xác nhận" body={`Tạo tài khoản là dùng ngay, nối ${liveBank} trong 4 bước, thêm bot vào nhóm Telegram là có báo có. ${priceCap}, không thu phần trăm trên số tiền.`} />

  <script>
    document.querySelector('[data-copy-prompt]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const txt = document.getElementById('ai-prompt')?.textContent || '';
      try { await navigator.clipboard.writeText(txt); btn.textContent = 'Đã chép'; setTimeout(() => (btn.textContent = 'Sao chép prompt'), 1500); } catch {}
    });
  </script>
</Base>

