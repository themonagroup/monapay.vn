---
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
interface Props { title: string; description: string; slug: string; date: string; updated?: string; keyword: string; category: string; h1?: string; ogImage?: string; faq?: { q: string; a: string }[] }
const { title, description, slug, date, updated, keyword, category, h1, ogImage, faq = [] } = Astro.props;
const path = '/blog/' + slug;
const iso = (d: string) => d.split('/').reverse().join('-');
const CAT: Record<string, string> = { 'huong-dan': 'Hướng dẫn', 'so-sanh': 'So sánh', 'chuyen-mona': 'Chuyện MONA', 'kien-thuc': 'Kiến thức' };
const jsonld: object[] = [{
  '@context': 'https://schema.org', '@type': 'Article', headline: h1 || title, description, inLanguage: 'vi',
  url: SITE.url + path, datePublished: iso(date), dateModified: iso(updated || date), keywords: keyword, articleSection: CAT[category],
  image: SITE.url + (ogImage || '/og/monapay-og.png'),
  author: { '@type': 'Organization', name: SITE.company, url: SITE.companyUrl }, publisher: { '@id': SITE.url + '/#organization' },
  isPartOf: { '@type': 'WebSite', '@id': SITE.url + '/#website' }, mainEntityOfPage: SITE.url + path,
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE.url + '/blog' },
    { '@type': 'ListItem', position: 3, name: h1 || title, item: SITE.url + path },
  ],
}];
if (faq.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={title} description={description} path={path} jsonld={jsonld} ogImage={ogImage}>
  <article class="wrap post">
    <header class="post-head">
      <p class="crumbs"><a href="/">Trang chủ</a> › <a href="/blog">Blog</a> › <span>{CAT[category]}</span></p>
      <h1>{h1 || title}</h1>
      <p class="post-meta">Đăng {date}{updated && updated !== date ? ` · cập nhật ${updated}` : ''} · {SITE.company}</p>
      {ogImage && <img class="post-cover" src={ogImage} alt={h1 || title} width="1536" height="1024" loading="eager" />}
    </header>
    <div class="post-body prose-md"><slot /></div>
    <p class="post-md"><a href={path + '.md'}>Bản markdown của bài này</a> · <a href="/llms.txt">llms.txt</a></p>
  </article>
  <CtaBand title="Tiền vào là đơn tự xác nhận. Tạo tài khoản, nối ACB trong vài phút" />
</Base>
<style>
  .post{max-width:820px;padding-top:40px;padding-bottom:24px}
  .crumbs{font-size:.88rem;color:var(--text-soft);margin-bottom:1rem}
  .post-head h1{font-size:clamp(1.5rem,2.6vw,2.05rem)}
  .post-meta{color:var(--text-soft);font-size:.92rem;margin-bottom:1.2rem}
  .post-cover{width:100%;height:auto;border-radius:var(--radius);box-shadow:var(--shadow-lg);margin:0 0 2rem}
  .post-body :global(> p:first-child){font-size:1.12rem;color:var(--ink);background:var(--surface);border:1px solid var(--border);border-left:5px solid var(--cta);border-radius:var(--radius-sm);padding:1rem 1.25rem;box-shadow:var(--shadow)}
  .post-body :global(> .answer-first:first-child){margin-bottom:1.1em}
  .post-body :global(h2){margin-top:2.2rem;font-size:1.55rem}
  .post-body :global(h3){margin-top:1.5rem}
  .post-body :global(img){border-radius:var(--radius-sm);box-shadow:var(--shadow)}
  .post-body :global(table){display:block;overflow-x:auto}
  .post-md{margin-top:2rem;font-size:.9rem;color:var(--text-soft)}
</style>
